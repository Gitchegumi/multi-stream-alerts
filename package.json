{
  "name": "multi-stream-alerts",
  "version": "0.1.8",
  "private": true,
  "description": "A self-hosted alert and overlay system for creators who want to own their stream tools, data, and assets instead of depending on third-party platforms.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @multi-stream-alerts/web dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @multi-stream-alerts/database prisma:generate",
    "prisma:migrate": "pnpm --filter @multi-stream-alerts/database prisma:migrate",
    "secrets:staged": "node scripts/gitleaks-staged.mjs",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "uuid": "11.1.1",
      "@hono/node-server": ">=1.19.13"
    }
  },
  "devDependencies": {
    "postcss": "8.5.15",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.0"
  }
}
