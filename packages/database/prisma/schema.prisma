generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  owner
  editor
  viewer
}

enum AlertPlatform {
  generic
  kofi
  twitch
  youtube
  tiktok
  manual
}

enum AlertType {
  tip
  follow
  subscription
  resubscription
  membership
  superchat
  supersticker
  raid
  cheer
  gift
  shop_order
  commission
  channel_point
  stream_online
  stream_offline
  test
  widget_event
  external_purchase
  hypechat
  charity_donation
  redemption
}

enum AssetSourceType {
  local
  s3
  external_url
}

enum AssetType {
  image
  video
  audio
}

model User {
  id                String                 @id @default(cuid())
  authProvider      String                 @map("auth_provider")
  authSubject       String                 @map("auth_subject")
  email             String                 @unique
  displayName       String?                @map("display_name")
  role              UserRole               @default(viewer)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  ownedChannels     Channel[]              @relation("ChannelOwner")
  memberships       ChannelMembership[]
  assets            WorkspaceAsset[]
  inviteCodes       InviteCode[]           @relation("InviteCodeCreator")
  inviteRedemptions InviteCodeRedemption[]
  localCredential   LocalCredential?

  @@unique([authProvider, authSubject])
  @@map("users")
}

model LocalCredential {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("local_credentials")
}

model InviteCode {
  id              String                 @id @default(cuid())
  code            String                 @unique
  role            UserRole               @default(owner)
  maxUses         Int                    @default(1) @map("max_uses")
  usedCount       Int                    @default(0) @map("used_count")
  expiresAt       DateTime?              @map("expires_at")
  isRevoked       Boolean                @default(false) @map("is_revoked")
  note            String?
  createdByUserId String                 @map("created_by_user_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdBy       User                   @relation("InviteCodeCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  redemptions     InviteCodeRedemption[]
  identityProviderInvite IdentityProviderInvite?

  @@index([createdByUserId])
  @@index([expiresAt])
  @@map("invite_codes")
}

model IdentityProviderInvite {
  id            String     @id @default(cuid())
  inviteCodeId  String     @unique @map("invite_code_id")
  provider      String
  externalToken String     @map("external_token")
  enrollmentUrl String?    @map("enrollment_url")
  expiresAt     DateTime?  @map("expires_at")
  usedAt        DateTime?  @map("used_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  inviteCode    InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("identity_provider_invites")
}

model InviteCodeRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String     @map("invite_code_id")
  userId       String     @map("user_id")
  redeemedAt   DateTime   @default(now()) @map("redeemed_at")
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId])
  @@index([userId])
  @@map("invite_code_redemptions")
}

model Channel {
  id                     String                    @id @default(cuid())
  name                   String
  slug                   String                    @unique
  ownerUserId            String?                   @map("owner_user_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  owner                  User?                     @relation("ChannelOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  memberships            ChannelMembership[]
  alertEvents            AlertEvent[]
  alertTemplates         AlertTemplate[]
  alertConfigs           WorkspaceAlertConfig[]
  alertLayouts           WorkspaceAlertLayout[]
  assets                 WorkspaceAsset[]
  storageSettings        WorkspaceStorageSettings?
  overlayProfiles        OverlayProfile[]
  integrationCredentials IntegrationCredential[]
  deduplicationKeys      DeduplicationKey[]

  @@map("channels")
}

model ChannelMembership {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_memberships")
}

model AlertEvent {
  id             String        @id
  channelId      String        @map("channel_id")
  platform       AlertPlatform
  type           AlertType
  eventKey       String?       @map("event_key")
  layoutId       String?       @map("layout_id")
  layoutName     String?       @map("layout_name")
  layoutStyle    String?       @map("layout_style")
  durationMs     Int?          @map("duration_ms")
  volume         Int?
  templateText   String?       @map("template_text")
  visualAssetUrl String?       @map("visual_asset_url")
  soundAssetUrl  String?       @map("sound_asset_url")
  displayName    String        @map("display_name")
  amount         Decimal?      @db.Decimal(12, 2)
  currency       String?
  message        String?
  isPublic       Boolean?      @map("is_public")
  tier           String?
  quantity       Int?
  rawEventId     String        @map("raw_event_id")
  rawPayloadJson Json?         @map("raw_payload_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  channel        Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([channelId, eventKey])
  @@index([platform, rawEventId])
  @@map("alert_events")
}

model AlertEventType {
  id          String                 @id @default(cuid())
  platform    AlertPlatform
  eventKey    String                 @unique @map("event_key")
  displayName String                 @map("display_name")
  legacyType  AlertType              @map("legacy_type")
  description String?
  sortOrder   Int                    @default(0) @map("sort_order")
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  configs     WorkspaceAlertConfig[]

  @@index([platform, sortOrder])
  @@map("alert_event_types")
}

model WorkspaceAlertLayout {
  id                String                 @id @default(cuid())
  channelId         String                 @map("channel_id")
  name              String
  style             String                 @default("vertical")
  visualAssetUrl    String?                @map("visual_asset_url")
  soundAssetUrl     String?                @map("sound_asset_url")
  visualAssetId     String?                @map("visual_asset_id")
  soundAssetId      String?                @map("sound_asset_id")
  animationSettings Json                   @default("{}") @map("animation_settings")
  editorLayout      Json                   @default("{}") @map("editor_layout")
  defaultDurationMs Int                    @default(6500) @map("default_duration_ms")
  defaultVolume     Int                    @default(80) @map("default_volume")
  isSystemPreset    Boolean                @default(false) @map("is_system_preset")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  channel           Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  visualAsset       WorkspaceAsset?        @relation("LayoutVisualAsset", fields: [visualAssetId], references: [id], onDelete: SetNull)
  soundAsset        WorkspaceAsset?        @relation("LayoutSoundAsset", fields: [soundAssetId], references: [id], onDelete: SetNull)
  configs           WorkspaceAlertConfig[]

  @@unique([channelId, name])
  @@index([channelId])
  @@index([visualAssetId])
  @@index([soundAssetId])
  @@map("workspace_alert_layouts")
}

model WorkspaceAsset {
  id               String                 @id @default(cuid())
  channelId        String                 @map("channel_id")
  ownerUserId      String?                @map("owner_user_id")
  sourceType       AssetSourceType        @map("source_type")
  assetType        AssetType              @map("asset_type")
  originalFilename String?                @map("original_filename")
  storedFilename   String?                @map("stored_filename")
  storageKey       String?                @map("storage_key")
  externalUrl      String?                @map("external_url")
  mimeType         String                 @map("mime_type")
  fileSizeBytes    BigInt?                @map("file_size_bytes")
  durationSeconds  Int?                   @map("duration_seconds")
  storageProvider  String                 @map("storage_provider")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  channel          Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  owner            User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  visualLayouts    WorkspaceAlertLayout[] @relation("LayoutVisualAsset")
  soundLayouts     WorkspaceAlertLayout[] @relation("LayoutSoundAsset")

  @@index([channelId, assetType])
  @@index([channelId, createdAt])
  @@map("workspace_assets")
}

model WorkspaceStorageSettings {
  id                           String   @id @default(cuid())
  channelId                    String   @unique @map("channel_id")
  quotaBytes                   BigInt   @default(536870912) @map("quota_bytes")
  maxFileSizeBytes             BigInt   @default(52428800) @map("max_file_size_bytes")
  allowedMimeTypes             String[] @default([]) @map("allowed_mime_types")
  serverUploadsEnabled         Boolean  @default(true) @map("server_uploads_enabled")
  nonAdminServerUploadsEnabled Boolean  @default(true) @map("non_admin_server_uploads_enabled")
  externalUrlsEnabled          Boolean  @default(true) @map("external_urls_enabled")
  s3Enabled                    Boolean  @default(false) @map("s3_enabled")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  channel                      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("workspace_storage_settings")
}

model WorkspaceAlertConfig {
  id               String                @id @default(cuid())
  channelId        String                @map("channel_id")
  alertEventTypeId String                @map("alert_event_type_id")
  enabled          Boolean               @default(false)
  layoutId         String?               @map("layout_id")
  displayName      String?               @map("display_name")
  templateText     String?               @map("template_text")
  durationMs       Int?                  @map("duration_ms")
  volume           Int?
  configJson       Json                  @default("{}") @map("config_json")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  channel          Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  alertEventType   AlertEventType        @relation(fields: [alertEventTypeId], references: [id], onDelete: Cascade)
  layout           WorkspaceAlertLayout? @relation(fields: [layoutId], references: [id], onDelete: Restrict)

  @@unique([channelId, alertEventTypeId])
  @@index([channelId, enabled])
  @@index([layoutId])
  @@map("workspace_alert_configs")
}

model AlertTemplate {
  id           String        @id @default(cuid())
  channelId    String        @map("channel_id")
  platform     AlertPlatform
  type         AlertType
  name         String
  templateJson Json          @map("template_json")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, platform, type, name])
  @@map("alert_templates")
}

model OverlayProfile {
  id           String   @id @default(cuid())
  channelId    String   @map("channel_id")
  name         String
  slug         String
  displayKey   String   @unique @map("display_key")
  isActive     Boolean  @default(true) @map("is_active")
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, slug])
  @@map("overlay_profiles")
}

model IntegrationCredential {
  id                  String                        @id @default(cuid())
  channelId           String                        @map("channel_id")
  provider            String // "kofi" | "twitch" | "youtube"
  isEnabled           Boolean                       @default(false) @map("is_enabled")
  // Public, non-secret fields. Empty/null = not set.
  twitchBroadcasterId String?                       @map("twitch_broadcaster_id")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  channel             Channel                       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  secrets             IntegrationCredentialSecret[]

  @@unique([channelId, provider])
  @@index([provider])
  @@map("integration_credentials")
}

model IntegrationCredentialSecret {
  id           String                @id @default(cuid())
  credentialId String                @map("credential_id")
  // Stable key string. Valid values:
  //   kofi.verification_token
  //   twitch.eventsub_secret
  //   twitch.client_id
  //   twitch.client_secret
  //   youtube.client_id
  //   youtube.client_secret
  // Add a Zod enum (or literal-type union) at the TS layer in Task 4 to keep callers honest.
  key          String
  // Output of secrets.encryptSecret. Empty string == cleared.
  ciphertext   String
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  credential   IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, key])
  @@index([key])
  @@map("integration_credential_secrets")
}

model DeduplicationKey {
  id         String   @id @default(cuid())
  provider   String
  rawEventId String   @map("raw_event_id")
  channelId  String   @map("channel_id")
  createdAt  DateTime @default(now()) @map("created_at")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([provider, rawEventId, channelId])
  @@map("deduplication_keys")
}
