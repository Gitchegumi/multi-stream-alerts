{
  "name": "@multi-stream-alerts/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://test:test@localhost:5432/test} INSTANCE_ENCRYPTION_KEY=${INSTANCE_ENCRYPTION_KEY:-$(node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\")} node --import tsx --test $(find src -path '*/__tests__/*.test.ts' -type f)",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@multi-stream-alerts/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
