{
  "name": "@multi-stream-alerts/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -path '*/__tests__/*.test.ts' -type f)",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@multi-stream-alerts/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
