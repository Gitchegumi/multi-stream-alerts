NODE_ENV=production

PUBLIC_BASE_URL=https://<your-alerts-domain>
# NEXT_PUBLIC_DOCS_URL=
INGRESS_PUBLIC_BASE_URL=https://<your-alerts-domain>
NEXTAUTH_URL=https://<your-alerts-domain>

# Public legal-page identity. Set these before publishing the OAuth app so
# users and provider reviewers can identify and contact the instance operator.
# LEGAL_OPERATOR_NAME=<your-name-or-organization>
# LEGAL_CONTACT_EMAIL=privacy@example.com

WEB_PORT=3000
INGRESS_PORT=8080

APP_DATA_PATH=/path/to/your/app/data
UPLOADS_PATH=/path/to/your/app/data/uploads
UPLOAD_DIR=/app/uploads

STORAGE_PROVIDER=local
DEFAULT_WORKSPACE_STORAGE_QUOTA_BYTES=536870912
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_ASSET_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,image/svg+xml,video/mp4,video/webm,audio/mpeg,audio/wav,audio/ogg,video/avi
SERVER_UPLOADS_ENABLED=true
NON_ADMIN_SERVER_UPLOADS_ENABLED=true
EXTERNAL_ASSET_URLS_ENABLED=true

# S3-compatible storage for MinIO / AIStor. Required only when
# STORAGE_PROVIDER=s3.
# S3_ENDPOINT=https://minio.example.com
# S3_BUCKET=gitchalerts-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<access-key>
# S3_SECRET_ACCESS_KEY=<secret-key>
# S3_FORCE_PATH_STYLE=true

DATABASE_URL=postgresql://alerts:<database-password>@alerts-postgres:5432/multi_stream_alerts
POSTGRES_DB=multi_stream_alerts
POSTGRES_USER=alerts
POSTGRES_PASSWORD=<database-password>

REDIS_URL=redis://alerts-redis:6379

DEFAULT_CHANNEL_SLUG=<default-channel-slug>
DEFAULT_CHANNEL_NAME=<default-channel-name>

INITIAL_DISPLAY_KEY=<long-random-display-key>
ADMIN_KEY=<long-random-admin-key>

# Twitch and YouTube are connected purely via OAuth: from Dashboard ->
# [workspace] -> Settings -> Integrations a user clicks "Connect", approves
# access, and the backend auto-provisions the EventSub / WebSub subscriptions.
# End users never enter EventSub secrets, Client IDs/Secrets, or stream keys.
# Only Ko-fi keeps a manual verification token (it has no OAuth flow).
#
# The Twitch/YouTube provider apps are therefore INSTANCE-level (admin/
# deployment) configuration. Without these vars the Connect buttons render a
# disabled "Unavailable" state.
#   Twitch app: grant the scopes the alert types need — user:read:email,
#     moderator:read:followers, channel:read:subscriptions, bits:read,
#     channel:read:charity, channel:read:redemptions. Expanding scopes forces
#     already-linked users to reconnect ("Needs reconnect" in Settings).
#   Google app: enable the YouTube Data API and grant youtube.readonly.
#   OAuth redirects use NEXTAUTH_URL and end in /api/auth/callback/twitch or
#   /api/auth/callback/google. EventSub/WebSub callbacks use
#   INGRESS_PUBLIC_BASE_URL (falling back to PUBLIC_BASE_URL).
# TWITCH_CLIENT_ID=<your-twitch-app-client-id>
# TWITCH_CLIENT_SECRET=<your-twitch-app-client-secret>
# GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# Optional: YouTube WebSub leases expire (~5 days) and the worker renews them
# automatically. Tune the sweep interval and how far ahead of expiry to renew
# (milliseconds). Defaults: hourly sweep, renew within 1 day of expiry.
# YOUTUBE_WEBSUB_RENEWAL_INTERVAL_MS=3600000
# YOUTUBE_WEBSUB_RENEWAL_LEAD_MS=86400000

AUTH_SECRET=<long-random-auth-secret>
AUTH_OIDC_ENABLED=true
AUTH_OIDC_ISSUER=https://<your-oidc-provider>/<issuer-path>
AUTH_OIDC_CLIENT_ID=<your-oidc-client-id>
AUTH_OIDC_CLIENT_SECRET=<your-oidc-client-secret>
# Local email/password auth is disabled by default. Enable only if you
# want invite-based local credential registration in addition to OIDC.
AUTH_CREDENTIALS_ENABLED=false

# Onboarding policy is separate from auth provider availability.
# With the defaults, first-time non-admin OIDC users must redeem an invite
# code from /register. Set ONBOARDING_REQUIRE_INVITE=false to allow any
# unknown OIDC user to receive their own workspace/channel.
ONBOARDING_ENABLED=true
ONBOARDING_REQUIRE_INVITE=true
ONBOARDING_DEFAULT_WORKSPACE_ROLE=owner

# Optional external OIDC enrollment redirect support. When enabled,
# /register?invite=<GitchAlerts-code> validates the GitchAlerts invite,
# sets the app invite cookie, and redirects to the linked provider
# enrollment URL. Authentik uses the query parameter "itoken".
OIDC_ENROLLMENT_ENABLED=false
# OIDC_ENROLLMENT_PROVIDER=authentik
# OIDC_ENROLLMENT_URL=https://<your-oidc-provider>/<enrollment-path>

# Required instance-level secret: 32-byte base64 key used to encrypt
# per-workspace platform credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored secret; operators must
# back up the key and re-enter all credentials after a rotation.
INSTANCE_ENCRYPTION_KEY=<base64-32-bytes>

# Required: secret key (min 16 characters) used to encrypt OAuth tokens
# for linked Twitch and YouTube accounts at rest. This is separate from
# INSTANCE_ENCRYPTION_KEY (which covers per-channel platform secrets) and
# must be consistent across the web app and background workers.
# Generate a strong key, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<strong-random-key-min-16-chars>
# Optional display name for the OIDC sign-in button. Defaults to "OIDC".
# AUTH_OIDC_PROVIDER_NAME="Authentik"
INITIAL_ADMIN_EMAIL=<your-admin-email>
